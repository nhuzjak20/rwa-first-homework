<tr id="pass-<%= pass.id %>" class="status-<%= pass.status.toLowerCase() %>">
  <td><a href="/info/<%= pass.id %>"><%= pass.name %></a></td>
  <td><%= pass.document %></td>
  <td><time datetime="<%= pass.issuedAt.toISOString() %>"><%= formatDateTime(pass.issuedAt) %></time></td>
  <td><span class="badge badge-<%= pass.status.toLowerCase() %>"><%= statusLabel(pass.status) %></span></td>
  <td class="row-actions">
    <a href="/admin/passes/<%= pass.id %>/qr.png" target="_blank" rel="noopener">QR kod</a>
    <% if (pass.status === 'ACTIVE') { %>
      <form method="post" action="/admin/passes/<%= pass.id %>/cancel"
            hx-post="/admin/passes/<%= pass.id %>/cancel" hx-target="#pass-<%= pass.id %>" hx-swap="outerHTML"
            hx-confirm="Poništiti propusnicu za <%= pass.name %>?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="secondary">Poništi</button>
      </form>
    <% } %>
    <form method="post" action="/admin/passes/<%= pass.id %>/delete"
          hx-post="/admin/passes/<%= pass.id %>/delete" hx-target="#pass-<%= pass.id %>" hx-swap="outerHTML"
          hx-confirm="Trajno obrisati propusnicu za <%= pass.name %>? Ova radnja se ne može poništiti.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="danger">Obriši</button>
    </form>
  </td>
</tr>
